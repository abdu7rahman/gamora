<?xml version="1.0"?>
<!--
  Entry point MoveItConfigsBuilder loads. It only forwards arguments to the real
  description in gamora_description, so the geometry lives in one place and this
  package stays purely configuration.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gamora_test_v6">
  <xacro:arg name="hardware" default="mock"/>
  <xacro:arg name="initial_positions_file"
             default="$(find gamora_moveit_config)/config/initial_positions.yaml"/>

  <xacro:include filename="$(find gamora_description)/urdf/gamora_test_v6.urdf.xacro"/>
</robot>
